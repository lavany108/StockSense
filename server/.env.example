# StockSense Pro — Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection URL (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stocksense_pro?schema=public

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_for_security
JWT_EXPIRES_IN=24h

# OTP Configuration
OTP_EXPIRY_MINUTES=10

# Email Delivery for OTP (Optional/Mockable)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="StockSense Pro <noreply@stocksense.local>"
